# Single-tenant credentials (stdio, and HTTP only when AUTH_MODE=env).
# The gateway-mode compose service does not load these. Do not add them to
# that service's environment or via env_file.
NINJAONE_CLIENT_ID=
NINJAONE_CLIENT_SECRET=
NINJAONE_REGION=us

# stdio (default) or http
MCP_TRANSPORT=stdio

# gateway: X-Ninja-Client-ID and X-Ninja-Client-Secret on each /mcp request.
#          Never falls back to NINJAONE_*. Docker image and Compose default.
# env:     use NINJAONE_* after X-Gateway-S2S verifies.
# AUTH_MODE=gateway

# Required to start the HTTP transport. The process logs an error and exits
# non-zero when this is empty or a known placeholder (changeme,
# replace-with-a-real-secret, your-s2s-secret, and similar). Compose will
# not start when it is unset. Never commit a real value.
# Generate one with: openssl rand -hex 32
CONDUIT_S2S_SECRET=

# Local development only. Set to exactly 1 to start HTTP without CONDUIT_S2S_SECRET.
# The server logs a warning, does not check X-Gateway-S2S, and binds 127.0.0.1
# even if MCP_HTTP_HOST is a wider address such as 0.0.0.0. A known placeholder
# secret is still refused. Do not use in production.
# MCP_ALLOW_INSECURE_DEV=1

# Bind address. When MCP_HTTP_HOST is unset, the HTTP server binds 127.0.0.1.
# A configured CONDUIT_S2S_SECRET is required before a wider address is honored.
# The container image sets 0.0.0.0.
# MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8080

LOG_LEVEL=info
