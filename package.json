{
  "name": "@wyre-ai/ninjaone-mcp",
  "version": "1.4.3",
  "description": "NinjaOne MCP server with decision tree architecture for Claude",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ninjaone-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc",
    "build:ui": "vite build && node scripts/embed-ui.mjs",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack:mcpb": "node scripts/pack-mcpb.js",
    "validate:mcpb": "mcpb validate manifest.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WYRE-AI/ninjaone-mcp.git"
  },
  "keywords": [
    "mcp",
    "claude",
    "ninjaone",
    "ninja",
    "rmm",
    "msp",
    "decision-tree"
  ],
  "author": "Wyre Technology",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/WYRE-AI/ninjaone-mcp/issues"
  },
  "homepage": "https://github.com/WYRE-AI/ninjaone-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@wyre-ai/node-ninjaone": "^2.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/ext-apps": "^2.0.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@types/node": "^26.6.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "semantic-release": "^25.0.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.1.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
